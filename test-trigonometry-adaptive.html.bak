<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes">
    <title>Умный тест: Тригонометрия</title>
    <style>
        *{margin:0;padding:0;box-sizing:border-box;}
        body{background:#1a2d3c;color:#e8edf3;font-family:'Segoe UI',Roboto,system-ui,sans-serif;padding:12px;user-select:none;-webkit-user-select:none;-moz-user-select:none;-ms-user-select:none;}
        .container{max-width:720px;margin:0 auto;background:#1e3545;border-radius:16px;padding:16px;padding-top:50px;position:relative;}

        .theme-toggle{position:absolute;top:10px;right:10px;width:34px;height:34px;border-radius:50%;background:#1e3545;border:1px solid #2a4a5a;cursor:pointer;font-size:16px;display:flex;align-items:center;justify-content:center;z-index:100;color:#b0c4d8;}
        .theme-toggle:hover{transform:scale(1.05);}
        .favorite-btn{position:fixed;bottom:20px;left:20px;width:44px;height:44px;border-radius:50%;background:#1e3545;border:1px solid #2a4a5a;cursor:pointer;font-size:24px;display:flex;align-items:center;justify-content:center;z-index:1000;color:#8ba5b8;transition:0.2s;}
        .favorite-btn.active{color:#facc15;}
        .favorite-btn:hover{transform:scale(1.05);}

        .header{text-align:center;padding:12px 0 16px;border-bottom:2px solid #2a4a5a;margin-bottom:14px;}
        .header h1{font-size:1.3rem;color:#e8edf3;font-weight:600;}
        .header .sub{color:#8ba5b8;font-size:0.75rem;margin-top:4px;}

        .settings{background:#162a38;border-radius:12px;padding:12px;margin-bottom:14px;border:1px solid #2a4a5a;display:flex;flex-wrap:wrap;gap:8px;align-items:center;}
        .settings label{color:#8ba5b8;font-size:0.8rem;}
        .settings select{padding:6px 10px;background:#1e3545;border:1px solid #2a4a5a;border-radius:8px;color:#e8edf3;font-size:0.85rem;cursor:pointer;}
        .settings select:focus{outline:none;border-color:#1abc9c;}
        .settings .start-btn{padding:8px 20px;background:#1abc9c;border:none;border-radius:24px;color:#0f1a24;font-weight:bold;font-size:0.9rem;cursor:pointer;transition:all 0.3s;margin-left:auto;box-shadow:0 0 14px rgba(26,188,156,0.2);animation:pulse-glow 2s ease-in-out infinite;}
        .settings .start-btn:hover{transform:scale(1.03);box-shadow:0 0 28px rgba(26,188,156,0.4);}
        .settings .start-btn:disabled{opacity:0.35;cursor:not-allowed;animation:none;box-shadow:none;}
        @keyframes pulse-glow{0%{box-shadow:0 0 10px rgba(26,188,156,0.15);transform:scale(1);}50%{box-shadow:0 0 26px rgba(26,188,156,0.4),0 0 50px rgba(26,188,156,0.1);transform:scale(1.02);}100%{box-shadow:0 0 10px rgba(26,188,156,0.15);transform:scale(1);}}
        .settings .reset-btn{background:#2c4a5a;border:none;border-radius:24px;color:#b0c4d8;padding:8px 16px;font-weight:500;cursor:pointer;transition:0.2s;font-size:0.8rem;}
        .settings .reset-btn:hover{background:#1a3a4a;}

        .mode-switch{display:flex;gap:4px;align-items:center;}
        .mode-btn{padding:5px 12px;border-radius:8px;border:1px solid #2a4a5a;background:transparent;color:#8ba5b8;cursor:pointer;transition:0.2s;font-size:0.75rem;}
        .mode-btn .hint{font-size:0.5rem;opacity:0.5;display:block;}
        .mode-btn.active{border-color:#1abc9c;color:#1abc9c;background:#1a3a3a;}
        .mode-btn.exam.active{border-color:#f59e0b;color:#f59e0b;background:#2a2a1a;}

        .stats-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:4px;margin-bottom:12px;}
        .stats-card{background:#162a38;border-radius:10px;padding:6px 3px;text-align:center;border:1px solid #2a4a5a;}
        .stats-card .label{font-size:0.5rem;color:#8ba5b8;text-transform:uppercase;letter-spacing:0.3px;}
        .stats-card .value{font-size:0.95rem;font-weight:600;margin-top:1px;}
        .stats-card .value.green{color:#34d399;}
        .stats-card .value.red{color:#f87171;}
        .stats-card .value.yellow{color:#fbbf24;}
        .stats-card .value.blue{color:#60a5fa;}
        .stats-card .value.purple{color:#a78bfa;}

        .progress-container{margin-bottom:10px;}
        .progress-info{display:flex;justify-content:space-between;font-size:0.7rem;color:#8ba5b8;margin-bottom:2px;}
        .progress-bar{height:4px;background:#2a4a5a;border-radius:4px;overflow:hidden;}
        .progress-fill{height:100%;background:#1abc9c;border-radius:4px;transition:width 0.4s;}

        .timer-container{display:flex;align-items:center;gap:8px;margin:4px 0 10px;padding:4px 10px;background:#162a38;border-radius:8px;border:1px solid #2a4a5a;}
        .timer-icon{font-size:0.9rem;}
        .timer-bar-wrap{flex:1;height:4px;background:#2a4a5a;border-radius:4px;overflow:hidden;}
        .timer-bar-fill{height:100%;border-radius:4px;transition:width 0.3s;background:#34d399;}
        .timer-text{font-weight:600;font-size:0.85rem;min-width:40px;text-align:right;color:#b0c4d8;}
        .timer-text.warning{color:#fbbf24;}
        .timer-text.danger{color:#ef4444;animation:blink 0.5s infinite;}
        @keyframes blink{0%,100%{opacity:1;}50%{opacity:0.3;}}

        .question-area{margin:10px 0;}
        .q-meta{display:flex;justify-content:space-between;align-items:center;margin-bottom:4px;flex-wrap:wrap;gap:4px;}
        .q-topic{font-size:0.65rem;color:#8ba5b8;background:#162a38;padding:2px 8px;border-radius:8px;}
        .q-difficulty{font-size:0.6rem;font-weight:600;padding:2px 8px;border-radius:8px;}
        .q-difficulty.easy{background:#1a3a2a;color:#6ee7b7;}
        .q-difficulty.medium{background:#3a2a1a;color:#fbbf24;}
        .q-difficulty.hard{background:#3a1a1a;color:#fca5a5;}
        .q-text{font-size:0.95rem;font-weight:500;line-height:1.5;margin:8px 0;}
        .q-number{color:#8ba5b8;font-size:0.7rem;}

        .options{display:flex;flex-direction:column;gap:4px;}
        .options button{display:block;width:100%;padding:10px 14px;background:#162a38;border:1px solid #2a4a5a;border-radius:10px;color:#e8edf3;font-size:0.9rem;text-align:left;cursor:pointer;transition:0.15s;}
        .options button:hover:not(:disabled){background:#1e3a4a;border-color:#1abc9c;}
        .options button.correct{background:#1a3a2a;border-color:#2ecc71;color:#6ee7b7;}
        .options button.wrong{background:#3a1a1a;border-color:#ef4444;color:#fca5a5;}
        .options button:disabled{cursor:default;opacity:0.6;}
        .options button:disabled:hover{background:#162a38;border-color:#2a4a5a;}

        .result-box{margin-top:10px;padding:8px 14px;border-radius:10px;display:none;font-weight:500;font-size:0.9rem;}
        .result-box.show{display:block;}
        .result-box.correct{background:#1a3a2a;border:1px solid #2ecc71;color:#6ee7b7;}
        .result-box.wrong{background:#3a1a1a;border:1px solid #ef4444;color:#fca5a5;}

        .controls{display:flex;gap:6px;margin-top:12px;flex-wrap:wrap;}
        .controls button{padding:8px 16px;border:none;border-radius:24px;font-weight:600;cursor:pointer;flex:1;min-width:70px;transition:0.2s;font-size:0.85rem;}
        .controls .next-btn{background:#1abc9c;color:#0f1a24;}
        .controls .next-btn:hover:not(:disabled){background:#16a085;transform:scale(1.02);}
        .controls .next-btn:disabled{opacity:0.35;cursor:not-allowed;}
        .controls .finish-btn{background:#f59e0b;color:#1a1a0a;}
        .controls .finish-btn:hover{background:#d97706;transform:scale(1.02);}
        .controls .abort-btn{background:#4a5a6a;color:#e8edf3;}
        .controls .abort-btn:hover{background:#3a4a5a;transform:scale(1.02);}
        .controls .abort-btn.active{background:#b91c1c;color:white;box-shadow:0 0 16px rgba(185,28,28,0.3);}

        .result-final{background:#162a38;border-radius:12px;padding:16px;margin-top:12px;display:none;border:1px solid #1abc9c;}
        .result-final.show{display:block;}
        .result-final .big-score{font-size:2rem;font-weight:700;text-align:center;margin:4px 0;}
        .result-final .big-score.excellent{color:#34d399;}
        .result-final .big-score.good{color:#fbbf24;}
        .result-final .big-score.poor{color:#f87171;}
        .result-final .grade-text{text-align:center;font-size:1rem;margin-bottom:8px;}
        .result-final .grade-text.excellent{color:#34d399;}
        .result-final .grade-text.good{color:#fbbf24;}
        .result-final .grade-text.poor{color:#f87171;}
        .result-final .result-details{text-align:center;color:#8ba5b8;font-size:0.8rem;}
        .result-final .result-mode{text-align:center;color:#8ba5b8;font-size:0.75rem;margin-top:2px;}

        .result-actions{display:flex;flex-wrap:wrap;gap:6px;justify-content:center;margin-top:10px;}
        .result-actions button{padding:6px 16px;border:none;border-radius:24px;font-weight:600;cursor:pointer;font-size:0.8rem;transition:0.2s;}
        .result-actions .retry-btn{background:#1abc9c;color:#0f1a24;}
        .result-actions .retry-btn:hover{background:#16a085;transform:scale(1.02);}
        .result-actions .share-btn{background:#2c5a77;color:#e8edf3;}
        .result-actions .share-btn:hover{background:#1a4a6a;transform:scale(1.02);}
        .result-actions .reference-btn{background:#8b5cf6;color:white;}
        .result-actions .reference-btn:hover{background:#7c3aed;transform:scale(1.02);}

        .share-modal{display:none;position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,0.7);z-index:2000;align-items:center;justify-content:center;}
        .share-modal.show{display:flex;}
        .share-modal .modal-content{background:#1e3545;border-radius:16px;padding:20px;max-width:380px;width:90%;border:1px solid #2a4a5a;}
        .share-modal .modal-title{text-align:center;font-size:1rem;font-weight:600;margin-bottom:10px;color:#e8edf3;}
        .share-modal .modal-close{float:right;background:none;border:none;color:#8ba5b8;font-size:1.2rem;cursor:pointer;padding:0 4px;}
        .share-modal .modal-close:hover{color:#e8edf3;}
        .share-modal input{width:100%;padding:8px 12px;border-radius:8px;border:1px solid #2a4a5a;background:#162a38;color:#e8edf3;font-size:0.9rem;margin-bottom:8px;}
        .share-modal input:focus{outline:none;border-color:#1abc9c;}
        .share-modal .modal-note{text-align:center;color:#8ba5b8;font-size:0.7rem;margin-top:8px;}
        .share-modal .modal-btn{width:100%;padding:8px;background:#1abc9c;border:none;border-radius:24px;color:#0f1a24;font-weight:bold;font-size:0.9rem;cursor:pointer;transition:0.2s;}
        .share-modal .modal-btn:hover{background:#16a085;transform:scale(1.02);}
        .share-modal .modal-btn:disabled{opacity:0.5;cursor:not-allowed;}

        .topic-stats{margin-top:10px;display:none;}
        .topic-stats.show{display:block;}
        .topic-stats-title{font-size:0.8rem;color:#8ba5b8;margin-bottom:4px;}
        .topic-row{display:flex;justify-content:space-between;padding:3px 0;font-size:0.75rem;border-bottom:1px solid #1e2a3a;}
        .topic-row .name{color:#8ba5b8;}
        .topic-row .stat{font-weight:500;}
        .topic-row .stat.good{color:#34d399;}
        .topic-row .stat.medium{color:#fbbf24;}
        .topic-row .stat.poor{color:#f87171;}

        .recommend-box{background:#162a38;border-radius:10px;padding:10px 14px;margin-top:10px;border-left:3px solid #fbbf24;display:none;}
        .recommend-box.show{display:block;}
        .recommend-box .title{font-weight:600;color:#fbbf24;font-size:0.8rem;}
        .recommend-box .list{color:#8ba5b8;font-size:0.75rem;margin-top:3px;padding-left:16px;}
        .recommend-box .list li{margin:2px 0;}

        .history{display:none;margin-top:12px;border-top:1px solid #2a4a5a;padding-top:10px;}
        .history.show{display:block;}
        .history-title{color:#8ba5b8;font-size:0.8rem;margin-bottom:4px;}
        .history-note{font-size:0.6rem;color:#5a7a8a;margin-bottom:4px;}
        .history-item{display:flex;justify-content:space-between;align-items:center;padding:2px 0;font-size:0.7rem;border-bottom:1px solid #1e2a3a;color:#8ba5b8;flex-wrap:wrap;gap:2px;}
        .history-item .h-grade{font-weight:600;}
        .history-item .h-grade.grade5{color:#34d399;}
        .history-item .h-grade.grade4{color:#fbbf24;}
        .history-item .h-grade.grade3{color:#f97316;}
        .history-item .h-grade.grade2{color:#f87171;}
        .history-actions{display:flex;gap:4px;margin-top:4px;flex-wrap:wrap;}
        .history-actions button{padding:2px 10px;border:none;border-radius:10px;color:#e8edf3;cursor:pointer;font-size:0.65rem;transition:0.2s;background:#2a4a5a;}
        .history-actions button:hover{background:#1a3a4a;}

        .back-link{display:block;text-align:center;margin-top:14px;padding:8px;background:#1abc9c;border-radius:24px;color:#0f1a24;text-decoration:none;font-weight:600;font-size:0.85rem;}
        .back-link:hover{background:#16a085;}

        .light-mode body{background:#eef2f8;}
        .light-mode .container{background:white;border:1px solid #e2e8f0;}
        .light-mode .header{border-bottom-color:#e2e8f0;}
        .light-mode .header h1{color:#1a2a3f;}
        .light-mode .settings{background:#f8fafc;border-color:#e2e8f0;}
        .light-mode .settings select{background:white;border-color:#e2e8f0;color:#1a2a3f;}
        .light-mode .mode-btn{color:#5a7a94;border-color:#e2e8f0;}
        .light-mode .mode-btn.active{border-color:#1abc9c;color:#1abc9c;background:#e8f8f5;}
        .light-mode .mode-btn.exam.active{border-color:#f59e0b;color:#d97706;background:#fef3c7;}
        .light-mode .stats-card{background:#f8fafc;border-color:#e2e8f0;}
        .light-mode .stats-card .label{color:#5a7a94;}
        .light-mode .q-text{color:#1a2a3f;}
        .light-mode .options button{background:white;border-color:#e2e8f0;color:#1a2a3f;}
        .light-mode .options button:hover:not(:disabled){background:#f1f5f9;border-color:#1abc9c;}
        .light-mode .options button.correct{background:#d1fae5;border-color:#059669;color:#065f46;}
        .light-mode .options button.wrong{background:#fee2e2;border-color:#dc2626;color:#991b1b;}
        .light-mode .theme-toggle{background:white;border:1px solid #e2e8f0;color:#1a2a3f;}
        .light-mode .result-box.correct{background:#d1fae5;border-color:#059669;color:#065f46;}
        .light-mode .result-box.wrong{background:#fee2e2;border-color:#dc2626;color:#991b1b;}
        .light-mode .q-topic{background:#f1f5f9;color:#5a7a94;}
        .light-mode .timer-container{background:#f8fafc;border-color:#e2e8f0;}
        .light-mode .timer-text{color:#1a2a3f;}
        .light-mode .share-modal .modal-content{background:white;border-color:#e2e8f0;}
        .light-mode .share-modal .modal-title{color:#1a2a3f;}
        .light-mode .share-modal .modal-close{color:#5a7a94;}
        .light-mode .share-modal .modal-close:hover{color:#1a2a3f;}
        .light-mode .share-modal input{background:white;border-color:#e2e8f0;color:#1a2a3f;}
        .light-mode .share-modal input:focus{border-color:#1abc9c;}
        .light-mode .share-modal .modal-note{color:#5a7a94;}
        .light-mode .topic-row{border-bottom-color:#e2e8f0;}
        .light-mode .topic-row .name{color:#5a7a94;}
        .light-mode .recommend-box{background:#f8fafc;border-left-color:#fbbf24;}
        .light-mode .result-final{background:#f8fafc;border-color:#1abc9c;}
        .light-mode .result-actions .reference-btn{background:#8b5cf6;color:white;}
        .light-mode .result-actions .reference-btn:hover{background:#7c3aed;}
        .light-mode .history{border-top-color:#e2e8f0;}
        .light-mode .history-item{border-bottom-color:#f1f5f9;color:#5a7a94;}
        .light-mode .history-actions button{background:#e2e8f0;color:#1a2a3f;}
        .light-mode .history-actions button:hover{background:#d1d5db;}
        .light-mode .settings .start-btn{color:white;}
        .light-mode .controls .abort-btn{background:#9ca3af;color:#1a2a3f;}
        .light-mode .controls .abort-btn:hover{background:#8a929f;}

        @media(max-width:550px){body{padding:8px;}.container{padding:12px;padding-top:44px;}.stats-grid{grid-template-columns:repeat(3,1fr);}.settings{flex-direction:column;align-items:stretch;}.settings .start-btn{margin-left:0;}.mode-switch{flex-wrap:wrap;}.result-final .big-score{font-size:1.6rem;}}
    </style>
    <script>
        MathJax = {tex:{inlineMath:[['$','$'],['\\(','\\)']]},chtml:{scale:0.95}};
    </script>
    <script src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-chtml.js" async></script>
</head>
<body>

<!-- ===== ЗАЩИТА ===== -->
<script>
    document.addEventListener('contextmenu', function(e) {
        e.preventDefault();
        alert('⚠️ Копирование и сохранение контента запрещено!');
        return false;
    });
    document.addEventListener('copy', function(e) {
        e.preventDefault();
        alert('⚠️ Копирование контента запрещено!');
        return false;
    });
    document.addEventListener('keydown', function(e) {
        if (e.key === 'F12' || e.keyCode === 123) {
            e.preventDefault();
            alert('⚠️ Инструменты разработчика отключены!');
            return false;
        }
        if (e.ctrlKey && e.shiftKey && (e.key === 'I' || e.key === 'J' || e.key === 'i' || e.key === 'j')) {
            e.preventDefault();
            alert('⚠️ Инструменты разработчика отключены!');
            return false;
        }
        if (e.ctrlKey && (e.key === 'u' || e.key === 'U' || e.key === 's' || e.key === 'S')) {
            e.preventDefault();
            alert('⚠️ Просмотр исходного кода и сохранение запрещены!');
            return false;
        }
        if (e.key === 'PrintScreen' || e.keyCode === 44) {
            e.preventDefault();
            alert('⚠️ Создание скриншотов запрещено!');
            return false;
        }
    });
    document.addEventListener('touchstart', function(e) {
        if (e.touches && e.touches.length > 1) {
            e.preventDefault();
            alert('⚠️ Масштабирование отключено!');
            return false;
        }
    }, { passive: false });
    document.addEventListener('gesturestart', function(e) {
        e.preventDefault();
        alert('⚠️ Масштабирование отключено!');
        return false;
    });
    document.addEventListener('visibilitychange', function() {
        if (document.hidden) {
            alert('⚠️ Переключение на другие приложения во время теста запрещено!');
        }
    });
</script>

<div class="container">
    <button class="theme-toggle" onclick="toggleTheme()" id="themeBtn">🌙</button>
    <button class="favorite-btn" id="favoriteBtn" onclick="toggleFavorite()">☆</button>

    <div class="header">
        <h1>Адаптивный тест: Тригонометрия</h1>
        <div class="sub">Адаптивная сложность · 460+ вопросов · 13 тем</div>
    </div>

    <!-- НАСТРОЙКИ -->
    <div class="settings" id="settingsPanel">
        <div style="display:flex;flex-wrap:wrap;gap:6px;align-items:center;flex:1;">
            <label for="questionLimit">Вопросов:</label>
            <select id="questionLimit">
                <option value="5">5</option>
                <option value="10">10</option>
                <option value="20" selected>20</option>
                <option value="30">30</option>
                <option value="50">50</option>
                <option value="0">∞</option>
            </select>
        </div>

        <div class="mode-switch">
            <button class="mode-btn active" data-mode="study" onclick="setMode('study')">
                📖 Учебный
                <span class="hint">без таймера</span>
            </button>
            <button class="mode-btn exam" data-mode="exam" onclick="setMode('exam')">
                📝 Экзамен
                <span class="hint">с таймером</span>
            </button>
        </div>

        <button class="start-btn" id="startBtn" onclick="startTest()">▶ Начать тест</button>
        <button class="reset-btn" onclick="resetFull()">Сброс</button>
    </div>

    <!-- СТАТИСТИКА -->
    <div class="stats-grid" id="statsGrid" style="display:none;">
        <div class="stats-card"><div class="label">Вопросов</div><div class="value blue" id="qCount">0</div></div>
        <div class="stats-card"><div class="label">Правильно</div><div class="value green" id="correctCount">0</div></div>
        <div class="stats-card"><div class="label">Ошибок</div><div class="value red" id="wrongCount">0</div></div>
        <div class="stats-card"><div class="label">Уровень</div><div class="value yellow" id="levelDisplay">Средний</div></div>
        <div class="stats-card"><div class="label">Осталось</div><div class="value purple" id="remainCount">0</div></div>
    </div>

    <!-- ПРОГРЕСС -->
    <div class="progress-container" id="progressContainer" style="display:none;">
        <div class="progress-info">
            <span id="progressText">Прогресс: 0%</span>
            <span id="answeredText">0 / 20</span>
        </div>
        <div class="progress-bar"><div class="progress-fill" id="progressFill" style="width:0%;"></div></div>
    </div>

    <!-- ТАЙМЕР -->
    <div class="timer-container" id="timerContainer" style="display:none;">
        <span class="timer-icon">⏱</span>
        <div class="timer-bar-wrap"><div class="timer-bar-fill" id="timerBarFill" style="width:100%;background:#34d399;"></div></div>
        <span class="timer-text" id="timerText">45 сек</span>
    </div>

    <!-- ВОПРОС -->
    <div class="question-area" id="questionArea" style="display:none;">
        <div class="q-meta">
            <span class="q-topic" id="qTopic">Тема: —</span>
            <span class="q-difficulty easy" id="qDifficulty">Лёгкий</span>
            <span class="q-number" id="qNumber">Вопрос №1</span>
        </div>
        <div class="q-text" id="qText">Настройте параметры и нажмите "Начать тест"</div>
        <div class="options" id="optionsContainer"></div>
    </div>

    <!-- РЕЗУЛЬТАТ ОТВЕТА -->
    <div class="result-box" id="resultBox"></div>

    <!-- КНОПКИ УПРАВЛЕНИЯ -->
    <div class="controls" id="controlsPanel" style="display:none;">
        <button class="next-btn" id="nextBtn" onclick="nextQuestion()" disabled>Далее →</button>
        <button class="finish-btn" id="finishBtn" onclick="finishTest()" style="display:none;">Завершить</button>
        <button class="abort-btn" id="abortBtn" onclick="abortTest()" style="display:none;">Прервать</button>
    </div>

    <!-- РЕЗУЛЬТАТ ТЕСТА -->
    <div class="result-final" id="resultFinal">
        <div class="grade-text" id="gradeText">Отлично!</div>
        <div class="big-score" id="bigScore">85%</div>
        <div class="result-details" id="resultDetails">20 вопросов · 17 правильно · 3 ошибки</div>
        <div class="result-mode" id="examResult">📖 Режим: учебный (без таймера)</div>
        <div class="result-actions">
            <button class="retry-btn" onclick="resetFull()">🔄 Пройти заново</button>
            <button class="share-btn" onclick="openShareModal()">📤 Поделиться</button>
            <button class="reference-btn" onclick="openReference()">📖 Повторить тему → справочник</button>
        </div>
    </div>

    <!-- РЕКОМЕНДАЦИИ -->
    <div class="recommend-box" id="recommendBox">
        <div class="title">📌 Рекомендации</div>
        <ul class="list" id="recommendList"></ul>
    </div>

    <!-- СТАТИСТИКА ПО ТЕМАМ -->
    <div class="topic-stats" id="topicStats">
        <div class="topic-stats-title">📊 Статистика по темам</div>
        <div id="topicStatsContent"></div>
    </div>

    <!-- ИСТОРИЯ -->
    <div class="history" id="historyPanel">
        <div class="history-title">📈 История результатов</div>
        <div class="history-note">📌 Сохраняется только на этом устройстве</div>
        <div id="historyList"></div>
        <div class="history-actions">
            <button onclick="exportHistory()">📤 Экспорт</button>
            <button onclick="document.getElementById('importFile').click()">📥 Импорт</button>
            <input type="file" id="importFile" accept=".json" style="display:none;" onchange="importHistory(event)">
            <button onclick="clearHistory()">🗑 Очистить</button>
        </div>
    </div>

    <a href="tests.html" class="back-link">← Назад к тестам</a>
</div>

<!-- МОДАЛЬНОЕ ОКНО ДЛЯ ВВОДА ДАННЫХ -->
<div class="share-modal" id="shareModal">
    <div class="modal-content">
        <button class="modal-close" onclick="closeShareModal()">✕</button>
        <div class="modal-title">📝 Введите данные</div>
        <input type="text" id="studentName" placeholder="Фамилия Имя">
        <input type="text" id="studentGroup" placeholder="Группа / Класс">
        <button class="modal-btn" id="shareSendBtn" onclick="sendShare()">📤 Отправить отчёт</button>
        <div class="modal-note">Откроется системное окно для выбора приложения</div>
    </div>
</div>

<script>
    // ================================================================
    // ПЕРЕМЕННЫЕ
    // ================================================================
    var currentMode = 'study';
    var timerInterval = null;
    var timeLeft = 0;
    var totalTime = 0;
    var abortClicked = false;

    var referenceLink = 'trigonometry.html';

    var state = {
        correct: 0,
        wrong: 0,
        level: 0,
        topicStats: {},
        usedQuestions: [],
        answered: 0,
        questionLimit: 20,
        isRunning: false,
        isFinished: false,
        streak: 0,
        currentQuestion: null,
        totalTimeSpent: 0,
        timePerQuestion: []
    };

    var levels = ['Лёгкий', 'Средний', 'Сложный'];
    var levelColors = ['#34d399', '#fbbf24', '#f87171'];

    // ================================================================
    // БАНК ВОПРОСОВ — ПОЛНАЯ ВЕРСИЯ (460+ вопросов)
    // ================================================================

    var identitiesBank = [
        {q:"\\(\\sin^2 \\alpha + \\cos^2 \\alpha = ?\\)",opts:["0","1","\\(\\sin\\alpha\\cos\\alpha\\)","\\(\\tan\\alpha\\)"],ans:1,diff:'easy',topic:"Основные тождества"},
        {q:"\\(\\tan \\alpha = ?\\)",opts:["\\(\\frac{\\sin\\alpha}{\\cos\\alpha}\\)","\\(\\frac{\\cos\\alpha}{\\sin\\alpha}\\)","\\(\\sin\\alpha\\cos\\alpha\\)","\\(\\sin^2\\alpha\\)"],ans:0,diff:'easy',topic:"Основные тождества"},
        {q:"\\(\\cot \\alpha = ?\\)",opts:["\\(\\frac{\\sin\\alpha}{\\cos\\alpha}\\)","\\(\\frac{\\cos\\alpha}{\\sin\\alpha}\\)","\\(\\sin\\alpha\\cos\\alpha\\)","\\(\\cos^2\\alpha\\)"],ans:1,diff:'easy',topic:"Основные тождества"},
        {q:"\\(\\tan\\alpha\\cdot\\cot\\alpha = ?\\)",opts:["0","1","\\(\\sin\\alpha\\)","\\(\\cos\\alpha\\)"],ans:1,diff:'easy',topic:"Основные тождества"},
        {q:"\\(1+\\tan^2\\alpha = ?\\)",opts:["\\(\\frac{1}{\\cos^2\\alpha}\\)","\\(\\frac{1}{\\sin^2\\alpha}\\)","\\(\\cos^2\\alpha\\)","\\(\\sin^2\\alpha\\)"],ans:0,diff:'easy',topic:"Основные тождества"},
        {q:"\\(1+\\cot^2\\alpha = ?\\)",opts:["\\(\\frac{1}{\\sin^2\\alpha}\\)","\\(\\frac{1}{\\cos^2\\alpha}\\)","\\(\\sin^2\\alpha\\)","\\(\\tan^2\\alpha\\)"],ans:0,diff:'easy',topic:"Основные тождества"},
        {q:"\\(\\sin^2\\alpha = ?\\)",opts:["\\(1-\\cos^2\\alpha\\)","\\(1+\\cos^2\\alpha\\)","\\(\\cos^2\\alpha-1\\)","\\(2\\cos^2\\alpha-1\\)"],ans:0,diff:'easy',topic:"Основные тождества"},
        {q:"\\(\\cos^2\\alpha = ?\\)",opts:["\\(1-\\sin^2\\alpha\\)","\\(1+\\sin^2\\alpha\\)","\\(\\sin^2\\alpha-1\\)","\\(2\\sin^2\\alpha-1\\)"],ans:0,diff:'easy',topic:"Основные тождества"},
        {q:"\\(\\tan\\alpha\\) выражается через \\(\\sin\\alpha\\) и \\(\\cos\\alpha\\):",opts:["\\(\\frac{\\sin\\alpha}{\\cos\\alpha}\\)","\\(\\frac{\\cos\\alpha}{\\sin\\alpha}\\)","\\(\\sin\\alpha\\cos\\alpha\\)","\\(\\sin^2\\alpha+\\cos^2\\alpha\\)"],ans:0,diff:'easy',topic:"Основные тождества"},
        {q:"\\(\\cot\\alpha\\) выражается через \\(\\sin\\alpha\\) и \\(\\cos\\alpha\\):",opts:["\\(\\frac{\\cos\\alpha}{\\sin\\alpha}\\)","\\(\\frac{\\sin\\alpha}{\\cos\\alpha}\\)","\\(\\sin\\alpha\\cos\\alpha\\)","\\(\\sin^2\\alpha+\\cos^2\\alpha\\)"],ans:0,diff:'easy',topic:"Основные тождества"},
        {q:"\\(\\tan^2\\alpha = ?\\)",opts:["\\(\\frac{1}{\\cos^2\\alpha}-1\\)","\\(\\frac{1}{\\sin^2\\alpha}-1\\)","\\(\\frac{1}{\\cos^2\\alpha}+1\\)","\\(1-\\frac{1}{\\sin^2\\alpha}\\)"],ans:0,diff:'medium',topic:"Основные тождества"},
        {q:"\\(\\cot^2\\alpha = ?\\)",opts:["\\(\\frac{1}{\\sin^2\\alpha}-1\\)","\\(\\frac{1}{\\cos^2\\alpha}-1\\)","\\(\\frac{1}{\\sin^2\\alpha}+1\\)","\\(1-\\frac{1}{\\cos^2\\alpha}\\)"],ans:0,diff:'medium',topic:"Основные тождества"},
        {q:"Упростить: \\(\\sin^2\\alpha+\\cos^2\\alpha+1\\)",opts:["0","1","2","\\(\\sin^2\\alpha\\)"],ans:2,diff:'easy',topic:"Основные тождества"},
        {q:"Упростить: \\(\\tan\\alpha\\cdot\\cot\\alpha-1\\)",opts:["0","1","-1","\\(\\tan\\alpha\\)"],ans:0,diff:'easy',topic:"Основные тождества"},
        {q:"Упростить: \\((1+\\tan^2\\alpha)\\cdot\\cos^2\\alpha\\)",opts:["0","1","\\(\\sin^2\\alpha\\)","\\(\\cos^2\\alpha\\)"],ans:1,diff:'medium',topic:"Основные тождества"},
        {q:"Упростить: \\((1+\\cot^2\\alpha)\\cdot\\sin^2\\alpha\\)",opts:["0","1","\\(\\sin^2\\alpha\\)","\\(\\cos^2\\alpha\\)"],ans:1,diff:'medium',topic:"Основные тождества"},
        {q:"Упростить: \\(\\frac{\\sin\\alpha}{\\cos\\alpha}\\cdot\\cos\\alpha\\)",opts:["\\(\\sin\\alpha\\)","\\(\\cos\\alpha\\)","\\(\\tan\\alpha\\)","1"],ans:0,diff:'easy',topic:"Основные тождества"},
        {q:"Упростить: \\(\\frac{\\cos\\alpha}{\\sin\\alpha}\\cdot\\sin\\alpha\\)",opts:["\\(\\sin\\alpha\\)","\\(\\cos\\alpha\\)","\\(\\cot\\alpha\\)","1"],ans:1,diff:'easy',topic:"Основные тождества"},
        {q:"Упростить: \\(\\sin^2\\alpha+\\tan^2\\alpha\\cos^2\\alpha\\)",opts:["0","1","\\(\\sin^2\\alpha\\)","\\(\\cos^2\\alpha\\)"],ans:1,diff:'medium',topic:"Основные тождества"},
        {q:"Упростить: \\(\\cos^2\\alpha+\\cot^2\\alpha\\sin^2\\alpha\\)",opts:["0","1","\\(\\sin^2\\alpha\\)","\\(\\cos^2\\alpha\\)"],ans:1,diff:'medium',topic:"Основные тождества"},
        {q:"Найти \\(\\sin\\alpha\\), если \\(\\cos\\alpha=0.8\\) и \\(\\alpha\\in(0^\\circ,90^\\circ)\\)",opts:["0.6","0.8","0.4","0.2"],ans:0,diff:'easy',topic:"Основные тождества"},
        {q:"Найти \\(\\cos\\alpha\\), если \\(\\sin\\alpha=0.6\\) и \\(\\alpha\\in(0^\\circ,90^\\circ)\\)",opts:["0.6","0.8","0.4","0.2"],ans:1,diff:'easy',topic:"Основные тождества"},
        {q:"Найти \\(\\tan\\alpha\\), если \\(\\sin\\alpha=0.6\\), \\(\\cos\\alpha=0.8\\)",opts:["0.75","1.25","0.5","0.8"],ans:0,diff:'easy',topic:"Основные тождества"},
        {q:"Найти \\(\\cot\\alpha\\), если \\(\\sin\\alpha=0.6\\), \\(\\cos\\alpha=0.8\\)",opts:["\\(\\frac{4}{3}\\)","\\(\\frac{3}{4}\\)","\\(\\frac{5}{4}\\)","\\(\\frac{4}{5}\\)"],ans:0,diff:'easy',topic:"Основные тождества"},
        {q:"Упростить: \\(\\sin^2\\alpha\\cdot\\cot^2\\alpha+\\sin^2\\alpha\\)",opts:["0","1","\\(\\sin^2\\alpha\\)","\\(\\cos^2\\alpha\\)"],ans:1,diff:'medium',topic:"Основные тождества"},
        {q:"Упростить: \\(\\cos^2\\alpha\\cdot\\tan^2\\alpha+\\cos^2\\alpha\\)",opts:["0","1","\\(\\sin^2\\alpha\\)","\\(\\cos^2\\alpha\\)"],ans:1,diff:'medium',topic:"Основные тождества"},
        {q:"Упростить: \\(\\frac{\\tan\\alpha}{\\sin\\alpha}-\\frac{1}{\\cos\\alpha}\\)",opts:["0","1","-1","\\(\\tan\\alpha\\)"],ans:0,diff:'hard',topic:"Основные тождества"},
        {q:"Упростить: \\(\\frac{\\cot\\alpha}{\\cos\\alpha}-\\frac{1}{\\sin\\alpha}\\)",opts:["0","1","-1","\\(\\cot\\alpha\\)"],ans:0,diff:'hard',topic:"Основные тождества"},
        {q:"Упростить: \\(1-\\sin^2\\alpha-\\cos^2\\alpha\\)",opts:["0","1","-1","\\(\\sin^2\\alpha\\)"],ans:0,diff:'easy',topic:"Основные тождества"},
        {q:"Упростить: \\(\\tan^2\\alpha\\cdot\\cos^2\\alpha+\\sin^2\\alpha\\)",opts:["0","1","\\(\\sin^2\\alpha\\)","\\(\\cos^2\\alpha\\)"],ans:1,diff:'medium',topic:"Основные тождества"},
        {q:"Упростить: \\(\\cot^2\\alpha\\cdot\\sin^2\\alpha+\\cos^2\\alpha\\)",opts:["0","1","\\(\\sin^2\\alpha\\)","\\(\\cos^2\\alpha\\)"],ans:1,diff:'medium',topic:"Основные тождества"},
        {q:"Упростить: \\(\\frac{1}{\\sin^2\\alpha}-\\cot^2\\alpha\\)",opts:["0","1","\\(\\sin^2\\alpha\\)","\\(\\cos^2\\alpha\\)"],ans:1,diff:'hard',topic:"Основные тождества"},
        {q:"Найти \\(\\sin\\alpha\\), если \\(\\cos\\alpha=0.5\\) и \\(\\alpha\\in(0^\\circ,90^\\circ)\\)",opts:["\\(\\frac{\\sqrt{3}}{2}\\)","\\(\\frac{1}{2}\\)","\\(\\frac{\\sqrt{2}}{2}\\)","1"],ans:0,diff:'easy',topic:"Основные тождества"},
        {q:"Найти \\(\\cos\\alpha\\), если \\(\\sin\\alpha=0.5\\) и \\(\\alpha\\in(0^\\circ,90^\\circ)\\)",opts:["\\(\\frac{\\sqrt{3}}{2}\\)","\\(\\frac{1}{2}\\)","\\(\\frac{\\sqrt{2}}{2}\\)","1"],ans:0,diff:'easy',topic:"Основные тождества"},
        {q:"Найти \\(\\tan\\alpha\\), если \\(\\sin\\alpha=0.5\\), \\(\\cos\\alpha=\\frac{\\sqrt{3}}{2}\\)",opts:["\\(\\frac{1}{\\sqrt{3}}\\)","\\(\\sqrt{3}\\)","\\(\\frac{\\sqrt{3}}{2}\\)","\\(\\frac{1}{2}\\)"],ans:0,diff:'easy',topic:"Основные тождества"},
        {q:"Найти \\(\\cot\\alpha\\), если \\(\\sin\\alpha=0.5\\), \\(\\cos\\alpha=\\frac{\\sqrt{3}}{2}\\)",opts:["\\(\\sqrt{3}\\)","\\(\\frac{1}{\\sqrt{3}}\\)","\\(\\frac{\\sqrt{3}}{2}\\)","\\(\\frac{1}{2}\\)"],ans:0,diff:'easy',topic:"Основные тождества"},
        {q:"Найти \\(\\cos\\alpha\\), если \\(\\tan\\alpha=1\\) и \\(\\alpha\\in(0^\\circ,90^\\circ)\\)",opts:["\\(\\frac{\\sqrt{2}}{2}\\)","\\(\\frac{1}{2}\\)","\\(\\frac{\\sqrt{3}}{2}\\)","1"],ans:0,diff:'medium',topic:"Основные тождества"},
        {q:"Найти \\(\\sin\\alpha\\), если \\(\\cot\\alpha=1\\) и \\(\\alpha\\in(0^\\circ,90^\\circ)\\)",opts:["\\(\\frac{\\sqrt{2}}{2}\\)","\\(\\frac{1}{2}\\)","\\(\\frac{\\sqrt{3}}{2}\\)","1"],ans:0,diff:'medium',topic:"Основные тождества"},
        {q:"Найти \\(\\tan\\alpha\\), если \\(\\cot\\alpha=\\sqrt{3}\\)",opts:["\\(\\frac{1}{\\sqrt{3}}\\)","\\(\\sqrt{3}\\)","1","0"],ans:0,diff:'medium',topic:"Основные тождества"},
        {q:"Найти \\(\\cot\\alpha\\), если \\(\\tan\\alpha=\\sqrt{3}\\)",opts:["\\(\\frac{1}{\\sqrt{3}}\\)","\\(\\sqrt{3}\\)","1","0"],ans:0,diff:'medium',topic:"Основные тождества"},
        {q:"Упростить: \\(\\frac{1-\\cos^2\\alpha}{\\sin\\alpha}\\)",opts:["\\(\\sin\\alpha\\)","\\(\\cos\\alpha\\)","\\(\\tan\\alpha\\)","1"],ans:0,diff:'medium',topic:"Основные тождества"},
        {q:"Упростить: \\(\\frac{1-\\sin^2\\alpha}{\\cos\\alpha}\\)",opts:["\\(\\sin\\alpha\\)","\\(\\cos\\alpha\\)","\\(\\tan\\alpha\\)","1"],ans:1,diff:'medium',topic:"Основные тождества"},
        {q:"Найти \\(\\sin\\alpha\\), если \\(\\cos\\alpha=\\frac{\\sqrt{3}}{2}\\) и \\(\\alpha\\in(0^\\circ,90^\\circ)\\)",opts:["\\(\\frac{1}{2}\\)","\\(\\frac{\\sqrt{3}}{2}\\)","\\(\\frac{\\sqrt{2}}{2}\\)","1"],ans:0,diff:'easy',topic:"Основные тождества"},
        {q:"Найти \\(\\cos\\alpha\\), если \\(\\sin\\alpha=\\frac{\\sqrt{3}}{2}\\) и \\(\\alpha\\in(0^\\circ,90^\\circ)\\)",opts:["\\(\\frac{1}{2}\\)","\\(\\frac{\\sqrt{3}}{2}\\)","\\(\\frac{\\sqrt{2}}{2}\\)","1"],ans:0,diff:'easy',topic:"Основные тождества"},
        {q:"Упростить: \\(\\sin^4\\alpha-\\cos^4\\alpha+1\\)",opts:["\\(2\\sin^2\\alpha\\)","\\(2\\cos^2\\alpha\\)","1","0"],ans:0,diff:'hard',topic:"Основные тождества"},
        {q:"Упростить: \\(\\sin^4\\alpha+\\cos^4\\alpha+2\\sin^2\\alpha\\cos^2\\alpha\\)",opts:["1","0","\\(\\sin^2\\alpha\\)","\\(\\cos^2\\alpha\\)"],ans:0,diff:'hard',topic:"Основные тождества"},
        {q:"Найти \\(\\tan\\alpha\\), если \\(\\sin\\alpha=\\frac{\\sqrt{2}}{2}\\), \\(\\cos\\alpha=\\frac{\\sqrt{2}}{2}\\)",opts:["1","-1","0","\\(\\frac{\\sqrt{2}}{2}\\)"],ans:0,diff:'easy',topic:"Основные тождества"},
        {q:"Найти \\(\\cot\\alpha\\), если \\(\\sin\\alpha=\\frac{\\sqrt{2}}{2}\\), \\(\\cos\\alpha=\\frac{\\sqrt{2}}{2}\\)",opts:["1","-1","0","\\(\\frac{\\sqrt{2}}{2}\\)"],ans:0,diff:'easy',topic:"Основные тождества"},
        {q:"Упростить: \\(\\frac{\\tan^2\\alpha}{1+\\tan^2\\alpha}\\)",opts:["\\(\\sin^2\\alpha\\)","\\(\\cos^2\\alpha\\)","\\(\\tan^2\\alpha\\)","1"],ans:0,diff:'hard',topic:"Основные тождества"},
        {q:"Упростить: \\(\\frac{\\cot^2\\alpha}{1+\\cot^2\\alpha}\\)",opts:["\\(\\cos^2\\alpha\\)","\\(\\sin^2\\alpha\\)","\\(\\cot^2\\alpha\\)","1"],ans:0,diff:'hard',topic:"Основные тождества"}
    ];

    var sumDiffBank = [
        {q:"\\(\\sin(\\alpha+\\beta)=?\\)",opts:["\\(\\sin\\alpha\\cos\\beta+\\cos\\alpha\\sin\\beta\\)","\\(\\sin\\alpha\\cos\\beta-\\cos\\alpha\\sin\\beta\\)","\\(\\cos\\alpha\\cos\\beta+\\sin\\alpha\\sin\\beta\\)","\\(\\cos\\alpha\\cos\\beta-\\sin\\alpha\\sin\\beta\\)"],ans:0,diff:'easy',topic:"Сумма и разность углов"},
        {q:"\\(\\sin(\\alpha-\\beta)=?\\)",opts:["\\(\\sin\\alpha\\cos\\beta-\\cos\\alpha\\sin\\beta\\)","\\(\\sin\\alpha\\cos\\beta+\\cos\\alpha\\sin\\beta\\)","\\(\\cos\\alpha\\cos\\beta+\\sin\\alpha\\sin\\beta\\)","\\(\\cos\\alpha\\cos\\beta-\\sin\\alpha\\sin\\beta\\)"],ans:0,diff:'easy',topic:"Сумма и разность углов"},
        {q:"\\(\\cos(\\alpha+\\beta)=?\\)",opts:["\\(\\cos\\alpha\\cos\\beta-\\sin\\alpha\\sin\\beta\\)","\\(\\cos\\alpha\\cos\\beta+\\sin\\alpha\\sin\\beta\\)","\\(\\sin\\alpha\\cos\\beta+\\cos\\alpha\\sin\\beta\\)","\\(\\sin\\alpha\\cos\\beta-\\cos\\alpha\\sin\\beta\\)"],ans:0,diff:'easy',topic:"Сумма и разность углов"},
        {q:"\\(\\cos(\\alpha-\\beta)=?\\)",opts:["\\(\\cos\\alpha\\cos\\beta+\\sin\\alpha\\sin\\beta\\)","\\(\\cos\\alpha\\cos\\beta-\\sin\\alpha\\sin\\beta\\)","\\(\\sin\\alpha\\cos\\beta+\\cos\\alpha\\sin\\beta\\)","\\(\\sin\\alpha\\cos\\beta-\\cos\\alpha\\sin\\beta\\)"],ans:0,diff:'easy',topic:"Сумма и разность углов"},
        {q:"\\(\\tan(\\alpha+\\beta)=?\\)",opts:["\\(\\frac{\\tan\\alpha+\\tan\\beta}{1-\\tan\\alpha\\tan\\beta}\\)","\\(\\frac{\\tan\\alpha-\\tan\\beta}{1+\\tan\\alpha\\tan\\beta}\\)","\\(\\tan\\alpha+\\tan\\beta\\)","\\(\\frac{\\tan\\alpha}{\\tan\\beta}\\)"],ans:0,diff:'easy',topic:"Сумма и разность углов"},
        {q:"\\(\\tan(\\alpha-\\beta)=?\\)",opts:["\\(\\frac{\\tan\\alpha-\\tan\\beta}{1+\\tan\\alpha\\tan\\beta}\\)","\\(\\frac{\\tan\\alpha+\\tan\\beta}{1-\\tan\\alpha\\tan\\beta}\\)","\\(\\tan\\alpha-\\tan\\beta\\)","\\(\\frac{\\tan\\alpha}{\\tan\\beta}\\)"],ans:0,diff:'easy',topic:"Сумма и разность углов"},
        {q:"\\(\\sin75^\\circ=?\\)",opts:["\\(\\frac{\\sqrt6+\\sqrt2}{4}\\)","\\(\\frac{\\sqrt6-\\sqrt2}{4}\\)","\\(\\frac{\\sqrt3}{2}\\)","\\(\\frac{1}{2}\\)"],ans:0,diff:'easy',topic:"Сумма и разность углов"},
        {q:"\\(\\sin15^\\circ=?\\)",opts:["\\(\\frac{\\sqrt6-\\sqrt2}{4}\\)","\\(\\frac{\\sqrt6+\\sqrt2}{4}\\)","\\(\\frac{\\sqrt3}{2}\\)","\\(\\frac{1}{2}\\)"],ans:0,diff:'easy',topic:"Сумма и разность углов"},
        {q:"\\(\\cos75^\\circ=?\\)",opts:["\\(\\frac{\\sqrt6-\\sqrt2}{4}\\)","\\(\\frac{\\sqrt6+\\sqrt2}{4}\\)","\\(\\frac{\\sqrt3}{2}\\)","\\(\\frac{1}{2}\\)"],ans:0,diff:'easy',topic:"Сумма и разность углов"},
        {q:"\\(\\cos15^\\circ=?\\)",opts:["\\(\\frac{\\sqrt6+\\sqrt2}{4}\\)","\\(\\frac{\\sqrt6-\\sqrt2}{4}\\)","\\(\\frac{\\sqrt3}{2}\\)","\\(\\frac{1}{2}\\)"],ans:0,diff:'easy',topic:"Сумма и разность углов"},
        {q:"\\(\\tan75^\\circ=?\\)",opts:["\\(2+\\sqrt3\\)","\\(2-\\sqrt3\\)","\\(\\sqrt3\\)","1"],ans:0,diff:'medium',topic:"Сумма и разность углов"},
        {q:"\\(\\tan15^\\circ=?\\)",opts:["\\(2-\\sqrt3\\)","\\(2+\\sqrt3\\)","\\(\\frac{1}{\\sqrt3}\\)","1"],ans:0,diff:'medium',topic:"Сумма и разность углов"},
        {q:"\\(\\sin105^\\circ=?\\)",opts:["\\(\\frac{\\sqrt6+\\sqrt2}{4}\\)","\\(\\frac{\\sqrt6-\\sqrt2}{4}\\)","\\(\\frac{\\sqrt3}{2}\\)","\\(\\frac{1}{2}\\)"],ans:0,diff:'hard',topic:"Сумма и разность углов"},
        {q:"\\(\\sin165^\\circ=?\\)",opts:["\\(\\frac{\\sqrt6-\\sqrt2}{4}\\)","\\(\\frac{\\sqrt6+\\sqrt2}{4}\\)","\\(\\frac{\\sqrt3}{2}\\)","\\(\\frac{1}{2}\\)"],ans:0,diff:'hard',topic:"Сумма и разность углов"},
        {q:"Упростить: \\(\\sin3\\alpha\\cos\\alpha+\\cos3\\alpha\\sin\\alpha\\)",opts:["\\(\\sin4\\alpha\\)","\\(\\sin2\\alpha\\)","\\(\\cos4\\alpha\\)","\\(\\cos2\\alpha\\)"],ans:0,diff:'medium',topic:"Сумма и разность углов"},
