        {q:"Решить неравенство: $\\sin x + \\cos x > 1$",opts:["$(0 + 2\\pi n; \\frac{\\pi}{2} + 2\\pi n)$","$(\\frac{\\pi}{4} + 2\\pi n; \\frac{5\\pi}{4} + 2\\pi n)$","$(\\frac{\\pi}{2} + 2\\pi n; \\pi + 2\\pi n)$","$(-\\frac{\\pi}{4} + 2\\pi n; \\frac{3\\pi}{4} + 2\\pi n)$"],ans:0,diff:'hard',topic:"Триг. неравенства"},
        {q:"Решить неравенство: $\\sin x + \\cos x < 0$",opts:["$(\\frac{3\\pi}{4} + 2\\pi n; \\frac{7\\pi}{4} + 2\\pi n)$","$(-\\frac{\\pi}{4} + 2\\pi n; \\frac{3\\pi}{4} + 2\\pi n)$","$(\\frac{\\pi}{4} + 2\\pi n; \\frac{5\\pi}{4} + 2\\pi n)$","$(-\\frac{3\\pi}{4} + 2\\pi n; \\frac{\\pi}{4} + 2\\pi n)$"],ans:0,diff:'hard',topic:"Триг. неравенства"},
        {q:"Решить неравенство: $\\sin^2 x < \\frac{1}{2}$",opts:["$(-\\frac{\\pi}{4} + \\frac{\\pi n}{2}; \\frac{\\pi}{4} + \\frac{\\pi n}{2})$","$(-\\frac{\\pi}{4} + \\pi n; \\frac{\\pi}{4} + \\pi n)$","$(\\frac{\\pi}{4} + \\frac{\\pi n}{2}; \\frac{3\\pi}{4} + \\frac{\\pi n}{2})$","$(-\\frac{\\pi}{2} + \\pi n; \\frac{\\pi}{2} + \\pi n)$"],ans:0,diff:'hard',topic:"Триг. неравенства"},
        {q:"Решить неравенство: $\\cos^2 x > \\frac{1}{4}$",opts:["$(-\\frac{\\pi}{3} + \\frac{\\pi n}{2}; \\frac{\\pi}{3} + \\frac{\\pi n}{2})$","$(-\\frac{\\pi}{3} + \\pi n; \\frac{\\pi}{3} + \\pi n)$","$(\\frac{\\pi}{3} + \\frac{\\pi n}{2}; \\frac{2\\pi}{3} + \\frac{\\pi n}{2})$","$(-\\frac{\\pi}{6} + \\pi n; \\frac{\\pi}{6} + \\pi n)$"],ans:0,diff:'hard',topic:"Триг. неравенства"},
        {q:"Решить неравенство: $\\sin x > \\cos 2x$",opts:["$(-\\frac{\\pi}{2} + 2\\pi n; \\frac{\\pi}{6} + 2\\pi n)$ или $(\\frac{5\\pi}{6} + 2\\pi n; \\frac{3\\pi}{2} + 2\\pi n)$","$(-\\frac{\\pi}{2} + 2\\pi n; \\frac{\\pi}{6} + 2\\pi n)$","$(\\frac{5\\pi}{6} + 2\\pi n; \\frac{3\\pi}{2} + 2\\pi n)$","$(-\\frac{\\pi}{6} + 2\\pi n; \\frac{\\pi}{6} + 2\\pi n)$"],ans:0,diff:'hard',topic:"Триг. неравенства"},
        {q:"Решить неравенство: $\\cos x < \\sin 2x$",opts:["$(\\frac{\\pi}{6} + 2\\pi n; \\frac{5\\pi}{6} + 2\\pi n)$ или $(\\frac{3\\pi}{2} + 2\\pi n; \\frac{13\\pi}{6} + 2\\pi n)$","$(\\frac{\\pi}{6} + 2\\pi n; \\frac{5\\pi}{6} + 2\\pi n)$","$(\\frac{3\\pi}{2} + 2\\pi n; \\frac{13\\pi}{6} + 2\\pi n)$","$(\\frac{\\pi}{3} + 2\\pi n; \\frac{2\\pi}{3} + 2\\pi n)$"],ans:0,diff:'hard',topic:"Триг. неравенства"},
        {q:"Решить неравенство: $\\tan x > \\cot x$",opts:["$(\\frac{\\pi}{4} + \\frac{\\pi n}{2}; \\frac{\\pi}{2} + \\frac{\\pi n}{2})$","$(\\frac{\\pi}{4} + \\pi n; \\frac{\\pi}{2} + \\pi n)$","$(-\\frac{\\pi}{4} + \\pi n; \\frac{\\pi}{4} + \\pi n)$","$(\\frac{\\pi}{4} + \\frac{\\pi n}{2}; \\frac{3\\pi}{4} + \\frac{\\pi n}{2})$"],ans:0,diff:'hard',topic:"Триг. неравенства"},
        {q:"Решить неравенство: $\\sin x \\cdot \\cos x < 0$",opts:["$(\\frac{\\pi}{2} + \\pi n; \\pi + \\pi n)$ или $(\\pi + \\pi n; \\frac{3\\pi}{2} + \\pi n)$","$(0 + \\pi n; \\frac{\\pi}{2} + \\pi n)$","$(\\frac{\\pi}{2} + 2\\pi n; \\pi + 2\\pi n)$","$(-\\frac{\\pi}{2} + \\pi n; \\frac{\\pi}{2} + \\pi n)$"],ans:0,diff:'hard',topic:"Триг. неравенства"},
        {q:"Решить неравенство: $\\sin x + \\sqrt{3}\\cos x < 0$",opts:["$(\\frac{2\\pi}{3} + 2\\pi n; \\frac{5\\pi}{3} + 2\\pi n)$","$(-\\frac{\\pi}{3} + 2\\pi n; \\frac{2\\pi}{3} + 2\\pi n)$","$(\\frac{\\pi}{3} + 2\\pi n; \\frac{4\\pi}{3} + 2\\pi n)$","$(-\\frac{2\\pi}{3} + 2\\pi n; \\frac{\\pi}{3} + 2\\pi n)$"],ans:0,diff:'hard',topic:"Триг. неравенства"},
        {q:"Решить неравенство: $\\sin x - \\cos x > 0$",opts:["$(\\frac{\\pi}{4} + 2\\pi n; \\frac{5\\pi}{4} + 2\\pi n)$","$(-\\frac{3\\pi}{4} + 2\\pi n; \\frac{\\pi}{4} + 2\\pi n)$","$(\\frac{\\pi}{4} + \\pi n; \\frac{5\\pi}{4} + \\pi n)$","$(-\\frac{\\pi}{4} + 2\\pi n; \\frac{3\\pi}{4} + 2\\pi n)$"],ans:0,diff:'hard',topic:"Триг. неравенства"}
    ];

    // ================================================================
    // СБОРКА ПОЛНОГО БАНКА
    // ================================================================
    var questionBank = identitiesBank.concat(sumDiffBank).concat(doubleBank).concat(halfBank)
        .concat(funcSumBank).concat(productBank).concat(signsBank)
        .concat(reductionBank).concat(parityBank).concat(valuesBank)
        .concat(equationsBank).concat(trigEquationsBank).concat(trigInequalitiesBank);

    // ================================================================
    // ФУНКЦИЯ ОТКРЫТИЯ СПРАВОЧНИКА
    // ================================================================

    function openReference() {
        window.location.href = referenceLink;
    }

    // ================================================================
    // ОСНОВНЫЕ ФУНКЦИИ (shuffleArray, getLevelValue, и т.д.)
    // ================================================================

    function shuffleArray(arr) {
        for (var i = arr.length - 1; i > 0; i--) {
            var j = Math.floor(Math.random() * (i + 1));
            var temp = arr[i];
            arr[i] = arr[j];
            arr[j] = temp;
        }
        return arr;
    }

    function getLevelValue(diff) {
        if (diff === 'easy') return 0;
        if (diff === 'medium') return 1;
        return 2;
    }

    function getLevelName(level) {
        return levels[level] || 'Средний';
    }

    function getTimeForDifficulty(diff) {
        if (currentMode === 'study') return 9999;
        switch(diff) {
            case 'easy': return 40;
            case 'medium': return 70;
            case 'hard': return 120;
            default: return 70;
        }
    }

    function setMode(mode) {
        currentMode = mode;
        document.querySelectorAll('.mode-btn').forEach(function(b) { b.classList.remove('active'); });
        document.querySelector('.mode-btn[data-mode="' + mode + '"]').classList.add('active');
        if (mode === 'exam') document.querySelector('.mode-btn.exam').classList.add('active');
    }

    function getWeakTopics() {
        var result = [];
        for (var topic in state.topicStats) {
            var stats = state.topicStats[topic];
            if (stats.total > 2) {
                var wrongPercent = stats.wrong / stats.total * 100;
                if (wrongPercent > 40) {
                    result.push({ topic: topic, wrongPercent: wrongPercent, wrong: stats.wrong, total: stats.total });
                }
            }
        }
        return result.sort(function(a, b) { return b.wrongPercent - a.wrongPercent; });
    }

    function getAvailableQuestions() {
        return questionBank.filter(function(q) { return state.usedQuestions.indexOf(q.q) === -1; });
    }

    function getNextQuestion() {
        var available = getAvailableQuestions();
        if (available.length === 0) {
            state.usedQuestions = [];
            available = questionBank;
        }

        var weakTopics = getWeakTopics();
        var question = null;

        if (weakTopics.length > 0 && Math.random() < 0.6) {
            var targetTopic = weakTopics[0].topic;
            var topicAvailable = available.filter(function(q) { return q.topic === targetTopic; });
            if (topicAvailable.length > 0) {
                question = topicAvailable[Math.floor(Math.random() * topicAvailable.length)];
            }
        }

        if (!question) {
            var level = state.level;
            var levelAvailable = available.filter(function(q) { return getLevelValue(q.diff) === level; });
            if (levelAvailable.length > 0) {
                question = levelAvailable[Math.floor(Math.random() * levelAvailable.length)];
            } else {
                question = available[Math.floor(Math.random() * available.length)];
            }
        }

        return question;
    }

    // ================================================================
    // ТАЙМЕР
    // ================================================================

    function startTimer(diff) {
        if (currentMode === 'study') {
            document.getElementById('timerContainer').style.display = 'none';
            return;
        }

        totalTime = getTimeForDifficulty(diff);
        timeLeft = totalTime;
        document.getElementById('timerContainer').style.display = 'flex';
        updateTimerDisplay();

        if (timerInterval) clearInterval(timerInterval);
        timerInterval = setInterval(function() {
            timeLeft--;
            updateTimerDisplay();
            if (timeLeft <= 0) {
                clearInterval(timerInterval);
                timerInterval = null;
                handleTimeUp();
            }
        }, 1000);
    }

    function updateTimerDisplay() {
        var percent = totalTime > 0 ? (timeLeft / totalTime) * 100 : 0;
        document.getElementById('timerBarFill').style.width = Math.max(0, percent) + '%';
        document.getElementById('timerText').textContent = Math.max(0, timeLeft) + ' сек';

        var timerText = document.getElementById('timerText');
        var timerBar = document.getElementById('timerBarFill');
        if (percent < 15) {
            timerText.className = 'timer-text danger';
            timerBar.style.background = '#ef4444';
        } else if (percent < 40) {
            timerText.className = 'timer-text warning';
            timerBar.style.background = '#fbbf24';
        } else {
            timerText.className = 'timer-text';
            timerBar.style.background = '#34d399';
        }
    }

    function handleTimeUp() {
        if (state.isFinished) return;
        var options = document.querySelectorAll('#optionsContainer button');
        options.forEach(function(btn) { btn.disabled = true; });

        var q = state.currentQuestion;
        var correct = q.ans;
        options.forEach(function(btn, idx) {
            var realIdx = parseInt(btn.dataset.realIndex);
            if (realIdx === correct) btn.className = 'correct';
        });

        var resultBox = document.getElementById('resultBox');
        resultBox.className = 'result-box show wrong';
        resultBox.innerHTML = '⏰ Время вышло! Правильный ответ: <strong>' + q.opts[correct] + '</strong>';

        state.wrong++;
        state.answered++;
        state.streak = 0;
        if (state.level > 0) state.level--;

        if (!state.topicStats[q.topic]) {
            state.topicStats[q.topic] = { correct: 0, wrong: 0, total: 0 };
        }
        state.topicStats[q.topic].wrong++;
        state.topicStats[q.topic].total++;

        state.usedQuestions.push(q.q);
        updateStats();
        updateTopicStats();
        updateRecommendations();

        if (state.answered >= state.questionLimit) {
            document.getElementById('nextBtn').style.display = 'none';
            document.getElementById('finishBtn').style.display = 'block';
        } else {
            document.getElementById('nextBtn').disabled = false;
        }
    }

    // ================================================================
    // ТЕСТ
    // ================================================================

    function startTest() {
        var startBtn = document.getElementById('startBtn');
        startBtn.style.animation = 'none';
        startBtn.style.boxShadow = 'none';
        startBtn.disabled = true;
        abortClicked = false;

        var limitSelect = document.getElementById('questionLimit');
        state.questionLimit = parseInt(limitSelect.value);
        if (state.questionLimit === 0) state.questionLimit = questionBank.length;

        state.correct = 0;
        state.wrong = 0;
        state.level = 0;
        state.topicStats = {};
        state.usedQuestions = [];
        state.answered = 0;
        state.isRunning = true;
        state.isFinished = false;
        state.streak = 0;
        state.totalTimeSpent = 0;
        state.timePerQuestion = [];
        state.currentQuestion = null;

        document.getElementById('settingsPanel').style.display = 'none';
        document.getElementById('statsGrid').style.display = 'grid';
        document.getElementById('progressContainer').style.display = 'block';
        document.getElementById('questionArea').style.display = 'block';
        document.getElementById('controlsPanel').style.display = 'flex';
        document.getElementById('resultFinal').className = 'result-final';
        document.getElementById('resultBox').className = 'result-box';
        document.getElementById('recommendBox').className = 'recommend-box';
        document.getElementById('topicStats').className = 'topic-stats';
        document.getElementById('finishBtn').style.display = 'none';
        document.getElementById('abortBtn').style.display = 'block';
        document.getElementById('abortBtn').className = 'abort-btn';
        document.getElementById('abortBtn').textContent = 'Прервать';

        var q = getNextQuestion();
        state.currentQuestion = q;
        state.usedQuestions.push(q.q);
        displayQuestion();
        startTimer(q.diff);
    }

    // ================================================================
    // displayQuestion — С ПЕРЕМЕШИВАНИЕМ ОТВЕТОВ
    // ================================================================

    function displayQuestion() {
        var q = state.currentQuestion;
        if (!q || state.answered >= state.questionLimit) {
            finishTest();
            return;
        }

        document.getElementById('qTopic').textContent = 'Тема: ' + q.topic;
        var diffLevel = getLevelValue(q.diff);
        document.getElementById('qDifficulty').textContent = getLevelName(diffLevel);
        document.getElementById('qDifficulty').className = 'q-difficulty ' + q.diff;
        document.getElementById('qNumber').textContent = 'Вопрос ' + (state.answered + 1) + ' из ' + state.questionLimit;
        document.getElementById('qText').textContent = q.q;

        // ===== ПЕРЕМЕШИВАЕМ ВАРИАНТЫ ОТВЕТОВ =====
        var container = document.getElementById('optionsContainer');
        container.innerHTML = '';

        var indices = q.opts.map(function(_, idx) { return idx; });
        for (var i = indices.length - 1; i > 0; i--) {
            var j = Math.floor(Math.random() * (i + 1));
            var temp = indices[i];
            indices[i] = indices[j];
            indices[j] = temp;
        }

        var letters = ['А', 'Б', 'В', 'Г'];
        for (var i = 0; i < indices.length; i++) {
            var btn = document.createElement('button');
            btn.textContent = letters[i] + '. ' + q.opts[indices[i]];
            btn.dataset.index = i;
            btn.dataset.realIndex = indices[i];
            btn.onclick = function() {
                if (this.disabled) return;
                checkAnswer(parseInt(this.dataset.index), parseInt(this.dataset.realIndex));
            };
            container.appendChild(btn);
        }

        updateStats();
        document.getElementById('nextBtn').disabled = true;
        document.getElementById('resultBox').className = 'result-box';
        updateTopicStats();
        updateRecommendations();

        if (window.MathJax && MathJax.typesetPromise) {
            MathJax.typesetPromise();
        }
    }

    // ================================================================
    // checkAnswer — с учётом перемешанных ответов
    // ================================================================

    function checkAnswer(selected, realIndex) {
        if (timerInterval) {
            clearInterval(timerInterval);
            timerInterval = null;
        }

        var q = state.currentQuestion;
        if (!q || state.isFinished) return;

        var correct = q.ans;
        var isCorrect = (realIndex === correct);
        var timeSpent = totalTime > 0 ? totalTime - timeLeft : 0;
        state.timePerQuestion.push(timeSpent);
        state.totalTimeSpent += timeSpent;

        if (isCorrect) {
            state.correct++;
            state.streak++;
        } else {
            state.wrong++;
            state.streak = 0;
        }
        state.answered++;

        if (!state.topicStats[q.topic]) {
            state.topicStats[q.topic] = { correct: 0, wrong: 0, total: 0 };
        }
        if (isCorrect) {
            state.topicStats[q.topic].correct++;
        } else {
            state.topicStats[q.topic].wrong++;
        }
        state.topicStats[q.topic].total++;

        if (!isCorrect) {
            if (state.level > 0) state.level--;
        } else {
            if (state.streak >= 5 && state.level < 2) {
                state.level++;
                state.streak = 0;
            }
        }

        state.usedQuestions.push(q.q);

        var resultBox = document.getElementById('resultBox');
        var options = document.querySelectorAll('#optionsContainer button');
        options.forEach(function(btn, idx) {
            btn.disabled = true;
            var btnRealIndex = parseInt(btn.dataset.realIndex);
            if (btnRealIndex === correct) {
                btn.className = 'correct';
            } else if (idx === selected && !isCorrect) {
                btn.className = 'wrong';
            }
        });

        if (isCorrect) {
            resultBox.className = 'result-box show correct';
            resultBox.innerHTML = '✅ Правильно!' + (currentMode === 'exam' ? ' (' + timeSpent + ' сек)' : '');
        } else {
            resultBox.className = 'result-box show wrong';
            resultBox.innerHTML = '❌ Неправильно. Правильный ответ: <strong>' + q.opts[correct] + '</strong>';
        }

        updateStats();
        updateTopicStats();
        updateRecommendations();

        if (state.answered >= state.questionLimit) {
            document.getElementById('nextBtn').style.display = 'none';
            document.getElementById('finishBtn').style.display = 'block';
        } else {
            document.getElementById('nextBtn').disabled = false;
        }
    }

    function nextQuestion() {
        if (state.answered >= state.questionLimit) {
            finishTest();
            return;
        }
        var q = getNextQuestion();
        if (q) {
            state.currentQuestion = q;
            state.usedQuestions.push(q.q);
            displayQuestion();
            startTimer(q.diff);
        } else {
            finishTest();
        }
    }

    // ================================================================
    // ПРЕРЫВАНИЕ
    // ================================================================

    function abortTest() {
        var btn = document.getElementById('abortBtn');

        if (!abortClicked) {
            abortClicked = true;
            btn.textContent = '❌ Закончить?';
            btn.className = 'abort-btn active';
            return;
        }

        if (timerInterval) {
            clearInterval(timerInterval);
            timerInterval = null;
        }

        state.isFinished = true;
        state.isRunning = false;
        showFinalResult(true);
    }

    // ================================================================
    // ФИНАЛЬНЫЙ РЕЗУЛЬТАТ
    // ================================================================

    function showFinalResult(aborted) {
        document.getElementById('questionArea').style.display = 'none';
        document.getElementById('controlsPanel').style.display = 'none';
        document.getElementById('progressContainer').style.display = 'none';
        document.getElementById('statsGrid').style.display = 'none';
        document.getElementById('timerContainer').style.display = 'none';

        var total = state.correct + state.wrong;
        var pct = total > 0 ? Math.round((state.correct / total) * 100) : 0;

        var gradeText = document.getElementById('gradeText');
        var bigScore = document.getElementById('bigScore');
        var resultDetails = document.getElementById('resultDetails');
        var examResult = document.getElementById('examResult');

        if (aborted) {
            gradeText.textContent = '⏸️ Тест прерван';
            gradeText.className = 'grade-text good';
            bigScore.textContent = pct + '%';
            bigScore.className = 'big-score good';
            resultDetails.textContent = 'Отвечено: ' + total + ' вопросов · ' + state.correct + ' правильно · ' + state.wrong + ' ошибок';
            document.getElementById('resultFinal').className = 'result-final show';
        } else {
            var difficultyBonus = 0;
            if (state.level >= 2) difficultyBonus = 5;
            else if (state.level >= 1) difficultyBonus = 2;
            var adjustedPct = Math.min(100, pct + difficultyBonus);

            var gradeClass = '';
            var gradeNum = 2;

            if (adjustedPct >= 90) {
                gradeText.textContent = 'Отлично!';
                gradeClass = 'excellent';
                gradeNum = 5;
            } else if (adjustedPct >= 75) {
                gradeText.textContent = 'Хорошо!';
                gradeClass = 'good';
                gradeNum = 4;
            } else if (adjustedPct >= 50) {
                gradeText.textContent = 'Удовлетворительно';
                gradeClass = 'good';
                gradeNum = 3;
            } else {
                gradeText.textContent = 'Требуется повторение';
                gradeClass = 'poor';
                gradeNum = 2;
            }

            gradeText.className = 'grade-text ' + gradeClass;
            bigScore.textContent = pct + '%';
            bigScore.className = 'big-score ' + gradeClass;
            resultDetails.textContent = total + ' вопросов · ' + state.correct + ' правильно · ' + state.wrong + ' ошибок';
            document.getElementById('resultFinal').className = 'result-final show';

            if (currentMode === 'exam' && state.timePerQuestion.length > 0) {
                var avgTime = Math.round(state.totalTimeSpent / state.timePerQuestion.length);
                examResult.textContent = '⏱️ Среднее время: ' + avgTime + ' сек на вопрос';
            } else {
                examResult.textContent = '📖 Режим: учебный (без таймера)';
            }

            saveResultAuto(gradeNum, pct, total);
        }

        document.getElementById('startBtn').disabled = false;
        document.getElementById('settingsPanel').style.display = 'flex';

        var startBtn = document.getElementById('startBtn');
        startBtn.style.animation = 'pulse-glow 2s ease-in-out infinite';
        startBtn.style.boxShadow = '0 0 14px rgba(26,188,156,0.2)';

        updateTopicStats();
        updateRecommendations();
        loadHistory();
        document.getElementById('resultFinal').scrollIntoView({ behavior: 'smooth', block: 'center' });
    }

    function finishTest() {
        if (state.isFinished) return;
        state.isFinished = true;
        state.isRunning = false;
        if (timerInterval) { clearInterval(timerInterval); timerInterval = null; }
        showFinalResult(false);
    }

    // ================================================================
    // СОХРАНЕНИЕ И ИСТОРИЯ
    // ================================================================

    function saveResultAuto(grade, pct, total) {
        var history = JSON.parse(localStorage.getItem('trigAdaptiveHistory') || '[]');
        var entry = {
            date: new Date().toLocaleString(),
            grade: grade,
            pct: pct,
            total: total,
            correct: state.correct,
            wrong: state.wrong,
            mode: currentMode === 'exam' ? 'Экзамен' : 'Учебный',
            level: getLevelName(state.level)
        };
        history.push(entry);
        if (history.length > 50) history.shift();
        localStorage.setItem('trigAdaptiveHistory', JSON.stringify(history));
        loadHistory();
    }

    function loadHistory() {
        var history = JSON.parse(localStorage.getItem('trigAdaptiveHistory') || '[]');
        var panel = document.getElementById('historyPanel');
        var list = document.getElementById('historyList');

        if (history.length === 0) {
            panel.className = 'history';
            return;
        }

        panel.className = 'history show';
        var html = '';
        for (var i = history.length - 1; i >= Math.max(0, history.length - 10); i--) {
            var h = history[i];
            var gradeClass = 'grade' + h.grade;
            html += '<div class="history-item">';
            html += '<span>' + h.date + ' · ' + h.mode + '</span>';
            html += '<span>' + h.correct + '✅ / ' + h.wrong + '❌ (' + h.pct + '%) </span>';
            html += '<span class="h-grade ' + gradeClass + '">' + h.grade + '</span>';
            html += '</div>';
        }
        list.innerHTML = html;
    }

    function exportHistory() {
        var history = JSON.parse(localStorage.getItem('trigAdaptiveHistory') || '[]');
        if (history.length === 0) { alert('История пуста!'); return; }
        var blob = new Blob([JSON.stringify(history, null, 2)], {type: 'application/json'});
        var url = URL.createObjectURL(blob);
        var a = document.createElement('a');
        a.href = url;
        a.download = 'trig_history_' + new Date().toISOString().slice(0,10) + '.json';
        a.click();
        URL.revokeObjectURL(url);
    }

    function importHistory(event) {
        var file = event.target.files[0];
        if (!file) return;
        var reader = new FileReader();
        reader.onload = function(e) {
            try {
                var data = JSON.parse(e.target.result);
                if (Array.isArray(data)) {
                    localStorage.setItem('trigAdaptiveHistory', JSON.stringify(data));
                    loadHistory();
                    alert('✅ История импортирована! (' + data.length + ' записей)');
                } else {
                    alert('❌ Неверный формат файла');
                }
            } catch(err) {
                alert('❌ Ошибка чтения файла: ' + err.message);
            }
        };
        reader.readAsText(file);
        document.getElementById('importFile').value = '';
    }

    function clearHistory() {
        if (confirm('Очистить всю историю результатов?')) {
            localStorage.removeItem('trigAdaptiveHistory');
            loadHistory();
        }
    }

    // ================================================================
    // ОТПРАВКА
    // ================================================================

    function openShareModal() {
        document.getElementById('shareModal').className = 'share-modal show';
        document.getElementById('studentName').focus();
    }

    function closeShareModal() {
        document.getElementById('shareModal').className = 'share-modal';
    }

    function sendShare() {
    var name = document.getElementById('studentName').value.trim();
    var group = document.getElementById('studentGroup').value.trim();

    if (!name) {
        alert('Пожалуйста, введите Фамилию и Имя');
        document.getElementById('studentName').focus();
        return;
    }
    if (!group) {
        alert('Пожалуйста, введите номер группы/класса');
        document.getElementById('studentGroup').focus();
        return;
    }

    closeShareModal();

    var text = getResultText(name, group);

    // ===== ЧЕРЕЗ ANDROID-МОСТ =====
    if (window.Android && window.Android.shareText) {
        window.Android.shareText(text);
    } else if (navigator.share) {
        navigator.share({
            title: 'Результат адаптивного теста',
            text: text
        }).catch(function(err) {
            console.log('Share cancelled or error:', err);
        });
    } else {
        copyToClipboard(text);
    }
}

    function copyToClipboard(text) {
        if (navigator.clipboard) {
            navigator.clipboard.writeText(text).then(function() {
                alert('📋 Отчёт скопирован в буфер обмена!');
            }).catch(function() {
                fallbackCopy(text);
            });
        } else {
            fallbackCopy(text);
        }
    }

    function fallbackCopy(text) {
        var textarea = document.createElement('textarea');
        textarea.value = text;
        textarea.style.position = 'fixed';
        textarea.style.top = '-9999px';
        textarea.style.left = '-9999px';
        document.body.appendChild(textarea);
        textarea.select();
        try {
            document.execCommand('copy');
            alert('📋 Отчёт скопирован в буфер обмена!');
        } catch(e) {
            alert('❌ Не удалось скопировать. Текст отчёта:\n\n' + text);
        }
        document.body.removeChild(textarea);
    }

    function getResultText(name, group) {
        var grade = document.getElementById('gradeText').textContent;
        var pct = document.getElementById('bigScore').textContent;
        var details = document.getElementById('resultDetails').textContent;
        var mode = currentMode === 'exam' ? 'Экзамен (с таймером)' : 'Учебный (без таймера)';
        var date = new Date().toLocaleString('ru-RU');

        var topicsText = '';
        var topics = Object.keys(state.topicStats);
        if (topics.length > 0) {
            for (var i = 0; i < topics.length; i++) {
                var stats = state.topicStats[topics[i]];
                var pctTopic = Math.round((stats.correct / stats.total) * 100);
                topicsText += '\n' + topics[i] + ' — ' + stats.correct + '✅ / ' + stats.wrong + '❌ (' + pctTopic + '%)';
            }
        } else {
            topicsText = '\nНет данных';
        }

        var weakTopics = getWeakTopics();
        var recText = '';
        if (weakTopics.length > 0) {
            recText = '\n\nРекомендации:\nПовторите тему(ы):';
            for (var i = 0; i < weakTopics.length; i++) {
                recText += '\n• ' + weakTopics[i].topic + ' (' + weakTopics[i].wrong + ' ошибок из ' + weakTopics[i].total + ')';
            }
        }

        return 'Адаптивный тест: Тригонометрия\n' +
               'Студент: ' + name + '\n' +
               'Группа: ' + group + '\n' +
               'Дата: ' + date + '\n' +
               'Режим: ' + mode + '\n' +
               details + '\n' +
               'Результат: ' + pct + '\n' +
               grade + '\n' +
               '\nСтатистика по темам:' + topicsText +
               recText +
               '\n\n#математика #тригонометрия #тест';
    }

    // ================================================================
    // СТАТИСТИКА И РЕКОМЕНДАЦИИ
    // ================================================================

    function updateStats() {
        document.getElementById('qCount').textContent = state.answered;
        document.getElementById('correctCount').textContent = state.correct;
        document.getElementById('wrongCount').textContent = state.wrong;
        document.getElementById('levelDisplay').textContent = getLevelName(state.level);
        document.getElementById('levelDisplay').style.color = levelColors[state.level];
        document.getElementById('remainCount').textContent = Math.max(0, state.questionLimit - state.answered);

        var progress = state.questionLimit > 0 ? Math.round((state.answered / state.questionLimit) * 100) : 0;
        document.getElementById('progressFill').style.width = Math.min(100, progress) + '%';
        document.getElementById('progressText').textContent = 'Прогресс: ' + Math.min(100, progress) + '%';
        document.getElementById('answeredText').textContent = state.answered + ' / ' + state.questionLimit;
    }

    function updateTopicStats() {
        var container = document.getElementById('topicStatsContent');
        var topics = Object.keys(state.topicStats);
        if (topics.length === 0 || state.answered === 0) {
            document.getElementById('topicStats').className = 'topic-stats';
            return;
        }
        document.getElementById('topicStats').className = 'topic-stats show';

        var html = '';
        var sorted = topics.sort(function(a, b) {
            var pctA = state.topicStats[a].correct / state.topicStats[a].total;
            var pctB = state.topicStats[b].correct / state.topicStats[b].total;
            return pctA - pctB;
        });

        for (var i = 0; i < sorted.length; i++) {
            var topic = sorted[i];
            var stats = state.topicStats[topic];
            var pct = Math.round((stats.correct / stats.total) * 100);
            var colorClass = pct >= 70 ? 'good' : (pct >= 50 ? 'medium' : 'poor');
            var colorText = pct >= 70 ? '#34d399' : (pct >= 50 ? '#fbbf24' : '#f87171');
            html += '<div class="topic-row">';
            html += '<span class="name">' + topic + '</span>';
            html += '<span class="stat ' + colorClass + '" style="color:' + colorText + ';">' + stats.correct + '✅ / ' + stats.wrong + '❌ (' + pct + '%)</span>';
            html += '</div>';
        }
        container.innerHTML = html;
    }

    function updateRecommendations() {
        var weakTopics = getWeakTopics();
        var box = document.getElementById('recommendBox');
        var list = document.getElementById('recommendList');

        if (weakTopics.length === 0 || state.answered < 3) {
            box.className = 'recommend-box';
            return;
        }

        box.className = 'recommend-box show';
        var html = '';
        for (var i = 0; i < Math.min(weakTopics.length, 3); i++) {
            var wt = weakTopics[i];
            html += '<li><strong>' + wt.topic + '</strong> — ' + wt.wrong + ' ошибок из ' + wt.total + ' (' + Math.round(wt.wrongPercent) + '%)</li>';
        }
        html += '<li style="margin-top:4px;color:#fbbf24;">Повторите эти темы в справочнике</li>';
        list.innerHTML = html;
    }

    // ================================================================
    // СБРОС
    // ================================================================

    function resetFull() {
        if (timerInterval) { clearInterval(timerInterval); timerInterval = null; }

        state.correct = 0;
        state.wrong = 0;
        state.level = 0;
        state.topicStats = {};
        state.usedQuestions = [];
        state.answered = 0;
        state.isRunning = false;
        state.isFinished = false;
        state.streak = 0;
        state.currentQuestion = null;
        state.totalTimeSpent = 0;
        state.timePerQuestion = [];
        abortClicked = false;

        document.getElementById('settingsPanel').style.display = 'flex';
        document.getElementById('statsGrid').style.display = 'none';
        document.getElementById('progressContainer').style.display = 'none';
        document.getElementById('questionArea').style.display = 'none';
        document.getElementById('controlsPanel').style.display = 'none';
        document.getElementById('resultFinal').className = 'result-final';
        document.getElementById('resultBox').className = 'result-box';
        document.getElementById('recommendBox').className = 'recommend-box';
        document.getElementById('topicStats').className = 'topic-stats';
        document.getElementById('timerContainer').style.display = 'none';
        document.getElementById('startBtn').disabled = false;
        document.getElementById('finishBtn').style.display = 'none';
        document.getElementById('nextBtn').style.display = 'block';
        document.getElementById('abortBtn').style.display = 'none';
        document.getElementById('abortBtn').className = 'abort-btn';
        document.getElementById('abortBtn').textContent = 'Прервать';

        var startBtn = document.getElementById('startBtn');
        startBtn.style.animation = 'pulse-glow 2s ease-in-out infinite';
        startBtn.style.boxShadow = '0 0 14px rgba(26,188,156,0.2)';

        document.getElementById('qText').textContent = 'Настройте параметры и нажмите "Начать тест"';
        document.getElementById('optionsContainer').innerHTML = '';
        loadHistory();
    }

    // ================================================================
    // ТЕМА И ИЗБРАННОЕ
    // ================================================================

    function toggleTheme() {
        var html = document.documentElement;
        var btn = document.getElementById('themeBtn');
        if (html.classList.contains('light-mode')) {
            html.classList.remove('light-mode');
            localStorage.setItem('mathTheme', 'dark');
            btn.textContent = '🌙';
        } else {
            html.classList.add('light-mode');
            localStorage.setItem('mathTheme', 'light');
            btn.textContent = '☀️';
        }
    }

    (function() {
        if (localStorage.getItem('mathTheme') === 'light') {
            document.documentElement.classList.add('light-mode');
            document.getElementById('themeBtn').textContent = '☀️';
        }
    })();

    var FAV_KEY = 'math_favorites';
    function getFavorites() { var s = localStorage.getItem(FAV_KEY); return s ? JSON.parse(s) : []; }
    function saveFavorites(f) { localStorage.setItem(FAV_KEY, JSON.stringify(f)); }
    function isFavorite() { var u = window.location.pathname.split('/').pop(); return getFavorites().includes(u); }
    function toggleFavorite() {
        var u = window.location.pathname.split('/').pop();
        var f = getFavorites();
        var btn = document.getElementById('favoriteBtn');
        if (f.includes(u)) {
            f = f.filter(function(x) { return x !== u; });
            btn.textContent = '☆';
            btn.classList.remove('active');
        } else {
            f.push(u);
            btn.textContent = '★';
            btn.classList.add('active');
        }
        saveFavorites(f);
    }
    function updateFavoriteBtn() {
        var btn = document.getElementById('favoriteBtn');
        if (btn) {
            if (isFavorite()) {
                btn.textContent = '★';
                btn.classList.add('active');
            } else {
                btn.textContent = '☆';
                btn.classList.remove('active');
            }
        }
    }
    updateFavoriteBtn();

    window.addEventListener('load', function() {
        document.getElementById('qText').textContent = 'Настройте параметры и нажмите "Начать тест"';
        document.getElementById('optionsContainer').innerHTML = '';
        document.getElementById('abortBtn').style.display = 'none';
        loadHistory();
    });

    document.getElementById('shareModal').addEventListener('click', function(e) {
        if (e.target === this) closeShareModal();
    });
</script>
</body>
</html>